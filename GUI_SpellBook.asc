// ==========================================
// GUI_SpellBook.asc (SCRIPT)
// Version 1.009
// ==========================================

int _spellbook_slot_spell_id[SPELLBOOK_CAPACITY];
int _selected_adventure_spell_id = -1;
int _spellbook_hover_slot = -1;
bool _spellbook_mouse_down = false;

int _spellbook_base_background = -1;
DynamicSprite* _spellbook_runtime_background;

// ==========================================
// Slot Layout Helpers
// ==========================================

// Returns which page/column this slot belongs to (0 = left page, 1 = right page).
int SpellBook_GetSlotColumn(int slot){
  return slot / 3;
}

// Returns the row index inside the page (0..2).
int SpellBook_GetSlotRow(int slot){
  return slot % 3;
}

// Pixel X position of the slot icon anchor.
int SpellBook_GetSlotIconX(int slot){
  return SPELLBOOK_SLOT_START_X + (SpellBook_GetSlotColumn(slot) * SPELLBOOK_SLOT_GAP_X);
}

// Pixel Y position of the slot icon anchor.
int SpellBook_GetSlotIconY(int slot){
  return SPELLBOOK_SLOT_START_Y + (SpellBook_GetSlotRow(slot) * SPELLBOOK_SLOT_GAP_Y);
}

// Pixel X position for text block (name/stats) relative to icon anchor.
int SpellBook_GetSlotTextX(int slot){
  return SpellBook_GetSlotIconX(slot) + SPELLBOOK_SLOT_TEXT_X_OFFSET;
}

// Pixel Y position for text block top.
int SpellBook_GetSlotTextY(int slot){
  return SpellBook_GetSlotIconY(slot);
}

// Pixel X position for description block.
int SpellBook_GetSlotDescX(int slot){
  return SpellBook_GetSlotIconX(slot);
}

// Pixel Y position for description block.
int SpellBook_GetSlotDescY(int slot){
  return SpellBook_GetSlotIconY(slot) + SPELLBOOK_SLOT_DESC_Y_OFFSET;
}

// ==========================================
// Slot Hit Testing
// ==========================================

// Converts screen mouse coordinates into a spell slot index (-1 if no slot hit).
int SpellBook_SlotFromScreenXY(int x, int y){
  int local_x = x - guiSpellBook.X;
  int local_y = y - guiSpellBook.Y;

  int i = 0;
  while (i < SPELLBOOK_CAPACITY){
    int left = SpellBook_GetSlotIconX(i);
    int top = SpellBook_GetSlotIconY(i);
    int right = left + 20;
    int bottom = top + 20;

    if (local_x >= left && local_x <= right && local_y >= top && local_y <= bottom){
      return i;
    }
    i++;
  }

  return -1;
}

// ==========================================
// Runtime Background Lifecycle
// ==========================================

// Deletes the runtime background sprite and restores original GUI background.
void SpellBook_ClearRuntimeBackground(){
  if (_spellbook_runtime_background != null){
    _spellbook_runtime_background.Delete();
    _spellbook_runtime_background = null;
  }

  if (_spellbook_base_background >= 0){
    guiSpellBook.BackgroundGraphic = _spellbook_base_background;
  }
}

// ==========================================
// Slot Data Cache
// ==========================================

// Rebuilds visual slot list from currently known hero spells.
void SpellBook_RebuildSlotCache(){
  int i = 0;
  while (i < SPELLBOOK_CAPACITY){
    _spellbook_slot_spell_id[i] = -1;
    i++;
  }

  if (gHeroStats == null){
    return;
  }

  i = 0;
  int slot = 0;
  while (i < gHeroStats.known_spell_count && slot < SPELLBOOK_CAPACITY){
    int spell_id = gHeroStats.known_spells[i];
    if (spell_id >= 0 && spell_id < SPELL_COUNT){
      _spellbook_slot_spell_id[slot] = spell_id;
      slot++;
    }
    i++;
  }
}

// ==========================================
// Text Utilities
// ==========================================

// Converts escaped "\n" sequences into real newlines for draw-time rendering.
String SpellBook_NormalizeLineBreaks(String text){
  String normalized = "";
  int i = 0;

  while (i < text.Length){
    String ch = text.Substring(i, 1);
    if (ch == "\\"){
      if ((i + 1) < text.Length && text.Substring(i + 1, 1) == "n"){
        normalized = normalized.Append("\n");
        i += 2;
        continue;
      }
    }

    normalized = normalized.Append(ch);
    i++;
  }

  return normalized;
}

// Draws multiline text by explicitly splitting lines (DrawingSurface newline-safe path).
void SpellBook_DrawMultilineText(DrawingSurface* surface, int x, int y, int font, String text, int line_spacing){
  String line = "";
  int draw_y = y;
  int i = 0;
  int line_height = GetFontHeight(font) + line_spacing;

  while (i < text.Length){
    String ch = text.Substring(i, 1);
    if (ch == "\n"){
      surface.DrawString(x, draw_y, font, line);
      line = "";
      draw_y += line_height;
    }
    else {
      line = line.Append(ch);
    }
    i++;
  }

  surface.DrawString(x, draw_y, font, line);
}

// ==========================================
// Slot Rendering
// ==========================================

// Draws a single spell slot entry (name, stats, description, icon state).
void SpellBook_DrawSlot(int slot, DrawingSurface* surface){
  // 1) Resolve which spell this visual slot currently points to.
  int spell_id = _spellbook_slot_spell_id[slot];
  if (spell_id < 0 || spell_id >= SPELL_COUNT){
    return;
  }

  // 2) Fetch display/runtime data for this spell.
  String spell_name = SpellDB_GetName(spell_id);
  String spell_desc = SpellBook_NormalizeLineBreaks(SpellDB_GetDescription(spell_id));
  int skill_value = 0;
  if (gHeroStats != null){
    skill_value = gHeroStats.spell_skill[spell_id];
  }
  int mp_cost = SpellDB_GetMPCost(spell_id, false, skill_value);

  // 3) Build optional selected marker.
  String selected_prefix = "";
  if (spell_id == _selected_adventure_spell_id){
    selected_prefix = "> ";
  }

  // 4) Compute draw anchors for this slot.
  int text_x = SpellBook_GetSlotTextX(slot);
  int text_y = SpellBook_GetSlotTextY(slot);
  int desc_x = SpellBook_GetSlotDescX(slot);
  int desc_y = SpellBook_GetSlotDescY(slot);
  int icon_x = SpellBook_GetSlotIconX(slot);
  int icon_y = SpellBook_GetSlotIconY(slot);

  // 5) Split spell name:
  //    - first letter uses Caps font (id 3)
  //    - remainder uses Normal font (id 0)
  String spell_first_letter = spell_name;
  String spell_rest = "";
  if (spell_name.Length > 0){
    spell_first_letter = spell_name.Substring(0, 1);
    if (spell_name.Length > 1){
      spell_rest = spell_name.Substring(1, spell_name.Length - 1);
    }
  }

  // 6) Draw first letter of spell name.
  surface.DrawingColor = 12645;
  surface.DrawString(
    text_x,
    text_y,
    3,
    spell_first_letter
  );

  // 7) Draw remaining spell name with a tiny Y baseline nudge.
  int name_offset_x = text_x + GetTextWidth(spell_first_letter, 3);
  surface.DrawString(
    name_offset_x,
    text_y + 2,
    0,
    String.Format("%s%s", selected_prefix, spell_rest)
  );

  // 8) Draw decorative strip underneath the stat line.
  int strip_x = text_x + SPELLBOOK_STAT_STRIP_X_OFFSET + 2;
  int strip_y = text_y + SPELLBOOK_STAT_STRIP_Y_OFFSET;
  surface.DrawImage(strip_x, strip_y, SPELLBOOK_STAT_STRIP_SPRITE);

  // 9) Draw MP/SKILL labels and values in segments so each part can
  //    use its own color/font alignment.
  int stat_x = text_x + 3;
  String mp_value = String.Format("%d", mp_cost);
  String skill_value_text = String.Format("%d", skill_value);
  int stat_y = text_y + SPELLBOOK_STAT_LINE_Y_OFFSET + 1;

  surface.DrawingColor = 44139;
  surface.DrawString(
    stat_x,
    stat_y,
    4,
    T("VITAL.MP")
  );

  stat_x += GetTextWidth(T("VITAL.MP"), 4) + 2;
  // 10) Draw multiline description text (already normalized for \n).
  surface.DrawingColor = 12645;
  surface.DrawString(
    stat_x,
    stat_y,
    4,
    mp_value
  );

  stat_x += GetTextWidth(mp_value, 4) + 8;
  surface.DrawingColor = 44139;
  surface.DrawString(
    stat_x,
    stat_y,
    4,
    T("SPELL.SKILL")
  );

  stat_x += GetTextWidth(T("SPELL.SKILL"), 4) + 2;
  surface.DrawingColor = 12645;
  surface.DrawString(
    stat_x,
    stat_y,
    4,
    skill_value_text
  );

  surface.DrawingColor = 12645;
  SpellBook_DrawMultilineText(surface, desc_x, desc_y, 0, spell_desc, 0);

  // 11) Resolve icon frame based on current mouse state.
  int icon_sprite = SpellDB_GetIconSpriteNormal(spell_id);
  if (slot == _spellbook_hover_slot){
    if (_spellbook_mouse_down){
      icon_sprite = SpellDB_GetIconSpritePressed(spell_id);
    }
    else {
      icon_sprite = SpellDB_GetIconSpriteMouseover(spell_id);
    }
  }

  // 12) Draw icon last so it stays visually on top.
  if (icon_sprite >= 0){
    surface.DrawImage(
      icon_x,
      icon_y,
      icon_sprite
    );
  }
}

// Rebuilds and redraws the whole spellbook page to a runtime dynamic sprite.
void SpellBook_RefreshView(){
  if (_spellbook_base_background < 0){
    _spellbook_base_background = guiSpellBook.BackgroundGraphic;
  }

  SpellBook_ClearRuntimeBackground();
  SpellBook_RebuildSlotCache();

  _spellbook_runtime_background = DynamicSprite.CreateFromExistingSprite(_spellbook_base_background, true);
  DrawingSurface* surface = _spellbook_runtime_background.GetDrawingSurface();

  int i = 0;
  while (i < SPELLBOOK_CAPACITY){
    SpellBook_DrawSlot(i, surface);
    i++;
  }

  surface.Release();
  guiSpellBook.BackgroundGraphic = _spellbook_runtime_background.Graphic;
}

// ==========================================
// Selection + Cursor Flow
// ==========================================

// Applies the spell cursor graphic to pointer mode.
void SpellBook_ApplySpellCursor(int spell_id){
  int cursor_sprite = SpellDB_GetCursorSprite(spell_id);
  if (cursor_sprite >= 0){
    Mouse.ChangeModeGraphic(eModePointer, cursor_sprite);
  }

  Mouse.UseModeGraphic(eModePointer);
  Mouse.Mode = eModePointer;
}

// Closes spellbook and restores core game UI state.
void SpellBook_CloseAndReturnToGame(){
  _spellbook_hover_slot = -1;
  _spellbook_mouse_down = false;
  SpellBook_ClearRuntimeBackground();
  guiSpellBook.Visible = false;
  gIconbar.Visible = true;
}

// Stores selected spell, applies cursor, and closes spellbook.
void SpellBook_SelectSpellAndClose(int spell_id){
  _selected_adventure_spell_id = spell_id;

  CursorEnableMouseModes();
  SpellBook_ApplySpellCursor(spell_id);
  SpellBook_CloseAndReturnToGame();
}

// ==========================================
// Selection State Accessors
// ==========================================

// Returns currently selected adventure spell id.
int SpellBook_GetSelectedSpellId(){
  return _selected_adventure_spell_id;
}

// Returns true if selected spell id is valid.
bool SpellBook_HasSelectedSpell(){
  return (_selected_adventure_spell_id >= 0 && _selected_adventure_spell_id < SPELL_COUNT);
}

// Clears selected adventure spell id.
void SpellBook_ClearSelectedSpell(){
  _selected_adventure_spell_id = -1;
}

// ==========================================
// Public UI Lifecycle
// ==========================================

// Updates hover/pressed state and redraws spellbook if interaction state changes.
void SpellBook_Update(){
  if (!guiSpellBook.Visible){
    return;
  }

  int hovered_slot = SpellBook_SlotFromScreenXY(mouse.x, mouse.y);
  bool is_down = mouse.IsButtonDown(eMouseLeft);

  if (hovered_slot != _spellbook_hover_slot || is_down != _spellbook_mouse_down){
    _spellbook_hover_slot = hovered_slot;
    _spellbook_mouse_down = is_down;
    SpellBook_RefreshView();
  }
}

// Opens spellbook UI and primes hover state for first frame.
void SpellBook_Open(){
  CursorDisableMouseModes();
  CursorForcePointerMode();

  gIconbar.Visible = false;
  guiSpellBook.Visible = true;
  _spellbook_hover_slot = SpellBook_SlotFromScreenXY(mouse.x, mouse.y);
  _spellbook_mouse_down = false;
  SpellBook_RefreshView();
}

// Handles spellbook mouse input while GUI is visible.
bool SpellBook_HandleClick(MouseButton button, int mouse_x, int mouse_y){
  if (!guiSpellBook.Visible){
    return false;
  }

  if (button != eMouseLeft){
    return true;
  }

  int slot = SpellBook_SlotFromScreenXY(mouse_x, mouse_y);
  if (slot < 0 || slot >= SPELLBOOK_CAPACITY){
    return true;
  }

  int spell_id = _spellbook_slot_spell_id[slot];
  if (spell_id < 0 || spell_id >= SPELL_COUNT){
    return true;
  }

  SpellBook_SelectSpellAndClose(spell_id);
  return true;
}

// ==========================================
// GUI Events
// ==========================================

// Close button event for spellbook GUI.
function btnSpellBookClose_OnClick(GUIControl *control, MouseButton button)
{
  CursorEnableMouseModes();
  SpellBook_CloseAndReturnToGame();
}